@ARTICLE{Medlyn2011a,
  title     = "Forest productivity under climate change: a checklist for
               evaluating model studies: Checklist for evaluating model studies",
  author    = "Medlyn, Belinda E and Duursma, Remko A and Zeppel, Melanie J B",

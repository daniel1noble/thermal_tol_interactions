@ARTICLE{Bujan2017,
  title     = "Nutrition modifies critical thermal maximum of a dominant canopy
               ant",
  author    = "Bujan, Jelena and Kaspari, Michael",
  journal   = "J. Insect Physiol.",
  publisher = "Elsevier",
  volume    =  102,
  pages     = "1--6",
  abstract  = "While adaptive responses to climate gradients are increasingly

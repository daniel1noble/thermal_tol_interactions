@ARTICLE{Mitchell2017,
  title     = "Effects of nutrient and water restriction on thermal tolerance: A
               test of mechanisms and hypotheses",
  author    = "Mitchell, Katherine A and Boardman, Leigh and Clusella-Trullas,

  journal   = "PLoS Biol.",
  publisher = "Public Library of Science (PLoS)",
  volume    =  5,
  number    =  5,
  pages     = "e96",
  abstract  = "Symbiosis is a ubiquitous phenomenon generating biological
               complexity, affecting adaptation, and expanding ecological
               capabilities. However, symbionts, which can be subject to genetic
               limitations such as clonality and genomic degradation, also
               impose constraints on hosts. A model of obligate symbiosis is

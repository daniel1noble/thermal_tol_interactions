@ARTICLE{Pottier2022a,
  title     = "Developmental plasticity in thermal tolerance: Ontogenetic
               variation, persistence, and future directions",
  author    = "Pottier, Patrice and Burke, Samantha and Zhang, Rose Y and Noble,

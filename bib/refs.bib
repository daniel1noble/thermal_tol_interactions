@ARTICLE{Bowler2022,
  title     = "Accounting for demographic uncertainty increases predictions for
               species coexistence: A case study with annual plants",
  author    = "Bowler, Catherine H and Weiss-Lehman, Christopher and Towers,
               Isaac R and Mayfield, Margaret M and Shoemaker, Lauren G",

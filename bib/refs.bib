               adapted to heat stress. Our findings demonstrate that the context
               under which hosts evolve is important for the evolution of
               beneficial associations and that protective microbes can
               facilitate host adaptation to stress. In turn, such host
               adaptation can benefit the microbe.",
  month     =  "17~" # mar,
  year      =  2021,
  keywords  = "TREE\_interactions",
  doi       = "10.1002/evl3.223"
}

@ARTICLE{Hoang2019,
  title     = "The effects of Bacillus subtilis on Caenorhabditis elegans
               fitness after heat stress",
  author    = "Hoang, Kim L and Gerardo, Nicole M and Morran, Levi T",
  journal   = "Ecol. Evol.",
  publisher = "Wiley",
  volume    =  9,
  number    =  6,
  pages     = "3491--3499",
  abstract  = "Microbes can provide their hosts with protection from biotic and

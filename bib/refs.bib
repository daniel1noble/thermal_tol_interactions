@ARTICLE{Duursma2019,
  title     = "On the minimum leaf conductance: its role in models of plant
               water use, and ecological and environmental controls",
  author    = "Duursma, Remko A and Blackman, Christopher J and Lopéz, Rosana
               and Martin-StPaul, Nicolas K and Cochard, Hervé and Medlyn,
